{
  "expo": {
    "name": "SparFlow",
    "slug": "sparflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "sparflow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redshoxx.sparflow",
      "buildNumber": "1",
      "infoPlist": {
        "UIFileSharingEnabled": false
      }
    },
    "android": {
      "package": "com.redshoxx.sparflow"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
