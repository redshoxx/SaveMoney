{
  "expo": {
    "name": "SparFlow",
    "slug": "sparflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "sparflow",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.redshoxx.sparflow",
      "buildNumber": "1",
      "infoPlist": {
        "UIFileSharingEnabled": false
      }
    },
    "android": {
      "package": "com.redshoxx.sparflow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7F4"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
